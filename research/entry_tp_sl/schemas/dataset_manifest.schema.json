{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btcognitive.local/schemas/entry-tp-sl-dataset-manifest.schema.json",
  "title": "BTCognitive Entry/TP/SL Dataset Snapshot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track_id", "status", "candidate_source", "instrument", "bars", "availability", "storage", "exclusions", "rights_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "track_id": {"const": "BTC-ENTRY-TP-SL-V3"},
    "status": {"enum": ["DATA_UNAVAILABLE", "CANDIDATE_ONLY", "SNAPSHOT_READY", "REJECTED"]},
    "candidate_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "dataset_ref", "version", "version_created_at_utc", "file_name", "file_bytes", "source_url", "declared_license", "upstream_source", "license_review"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "dataset_ref": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "version_created_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "file_name": {"type": "string", "minLength": 1},
        "file_bytes": {"type": ["integer", "null"], "minimum": 0},
        "source_url": {"type": "string", "format": "uri"},
        "declared_license": {"type": "string", "minLength": 1},
        "upstream_source": {"type": "string", "minLength": 1},
        "license_review": {"enum": ["UNVERIFIED", "REVIEW_REQUIRED", "APPROVED", "REJECTED"]}
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "base_asset", "quote_asset", "venue", "product_type", "symbol", "settlement_asset", "margin_mode"],
      "properties": {
        "status": {"enum": ["CANDIDATE_NOT_FROZEN", "FROZEN"]},
        "base_asset": {"type": "string"},
        "quote_asset": {"type": "string"},
        "venue": {"type": "string"},
        "product_type": {"enum": ["spot", "linear_perpetual", "inverse_perpetual"]},
        "symbol": {"type": "string"},
        "settlement_asset": {"type": ["string", "null"]},
        "margin_mode": {"type": ["string", "null"]},
        "tick_size": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "contract_multiplier": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "bars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_interval_seconds", "path_interval_seconds", "timestamp_unit", "timestamp_role", "timestamp_semantics_status", "required_columns", "available_time_rule"],
      "properties": {
        "decision_interval_seconds": {"const": 900},
        "path_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "timestamp_unit": {"enum": ["unix_seconds", "unix_milliseconds", "iso8601_utc"]},
        "timestamp_role": {"enum": ["bar_open", "bar_close", "event_time", "unknown"]},
        "timestamp_semantics_status": {"enum": ["UNVERIFIED", "VERIFIED"]},
        "required_columns": {"type": "array", "items": {"type": "string"}, "minItems": 5, "uniqueItems": true},
        "available_time_rule": {"type": ["string", "null"]},
        "timezone": {"const": "UTC"}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "local_snapshot_present", "sha256", "row_count", "coverage_start_utc", "coverage_end_utc", "gap_audit_status"],
      "properties": {
        "status": {"enum": ["DATA_UNAVAILABLE", "CANDIDATE_ONLY", "SNAPSHOT_READY"]},
        "local_snapshot_present": {"type": "boolean"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "coverage_start_utc": {"type": ["string", "null"], "format": "date-time"},
        "coverage_end_utc": {"type": ["string", "null"], "format": "date-time"},
        "gap_audit_status": {"enum": ["NOT_RUN", "GAPS_FOUND", "NO_GAPS", "FAILED"]},
        "duplicate_count": {"type": ["integer", "null"], "minimum": 0},
        "invalid_ohlc_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred_backend", "selected_backend", "remote_uri", "immutable_object_id", "local_cache_path"],
      "properties": {
        "preferred_backend": {"enum": ["google_drive", "kaggle", "gcs", "s3", "azure_blob", "local"]},
        "selected_backend": {"type": ["string", "null"]},
        "remote_uri": {"type": ["string", "null"]},
        "immutable_object_id": {"type": ["string", "null"]},
        "local_cache_path": {"type": ["string", "null"]}
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["har_ohlcv_reused", "iv7d_used", "har_artifacts_used"],
      "properties": {
        "har_ohlcv_reused": {"const": false},
        "iv7d_used": {"const": false},
        "har_artifacts_used": {"const": false}
      }
    },
    "rights_status": {"enum": ["UNVERIFIED", "REVIEW_REQUIRED", "APPROVED", "REJECTED"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SNAPSHOT_READY"}}, "required": ["status"]},
      "then": {
        "properties": {
          "availability": {"properties": {"status": {"const": "SNAPSHOT_READY"}, "local_snapshot_present": {"const": true}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "row_count": {"type": "integer", "minimum": 1}, "gap_audit_status": {"enum": ["GAPS_FOUND", "NO_GAPS"]}}},
          "storage": {"properties": {"selected_backend": {"type": "string"}, "immutable_object_id": {"type": "string", "minLength": 1}}},
          "instrument": {"properties": {"status": {"const": "FROZEN"}}},
          "rights_status": {"const": "APPROVED"}
        }
      }
    }
  ]
}

  },
  "r_multiple_accounting": {
    "one_r_definition_usd": "P_entry * sl_multiplier * sigma_t0",
    "gross_r_tp_exit": "+(tp_multiplier / sl_multiplier)",
    "gross_r_sl_exit": -1.0,
    "gross_r_timeout_exit_formula": "(side_sign * (P_timeout - P_entry)) / (P_entry * sl_multiplier * sigma_t0)",
    "timeout_is_never_hardcoded_minus_one_r": true,
    "net_r_formula": "gross_r - (round_trip_cost_fraction / (sl_multiplier * sigma_t0))"
  },
  "intrabar_ambiguity_policy": {
    "unresolved_dual_touch_policy": "CONSERVATIVE_SL_FIRST",

      "name": "ATR_14_15M",
      "lookback_periods": 14,
      "bar_interval_minutes": 15,
      "formula": "ATR_14(15m) / Close_t0",
      "scientific_rationale": "Causal local range metric matched to high-low boundary mechanics, robust to jump discontinuities, zero lookahead leakage."
    },
    "PRE_REGISTERED_SECONDARY": {
      "name": "REALIZED_VOLATILITY_24H_15M",
      "lookback_periods": 96,
      "bar_interval_minutes": 15,
      "formula": "std(log_returns_15m, 96) * sqrt(96)"
    }
  },
  "predetermined_barrier_grid": [
    {
      "pair_id": "barrier_pair_01",
      "role": "PRIMARY_REFERENCE",
      "tp_multiplier": 1.0,

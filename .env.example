# BTCognitive Prediction Lab — Environment Configuration

# Environment Mode (development | production)
BTC_ENVIRONMENT=development
PORT=8000

# Security. Set BTCOGNITIVE_ADMIN_KEY to a long random value before enabling
# notification management or administrative API operations.
BTCOGNITIVE_USER_KEY=
BTCOGNITIVE_RESEARCH_KEY=
BTCOGNITIVE_ADMIN_KEY=
BTCOGNITIVE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BTCOGNITIVE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Exact hostnames only; generic webhook destinations must be explicitly trusted.
BTCOGNITIVE_WEBHOOK_ALLOWED_HOSTS=discord.com

# Cloud Persistence ($0/mo Free Tier Turso LibSQL Database - Optional)
# Leave blank to use local SQLite WAL (experiments/results/market_memory.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional email notification credentials. No personal recipient is configured by default.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_RECIPIENT=

# Optional Discord / generic webhook and Telegram credentials.
WEBHOOK_ENABLED=false
WEBHOOK_TYPE=discord
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

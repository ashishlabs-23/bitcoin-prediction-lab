# BTCognitive Prediction Lab — Environment Configuration

# Environment Mode (development | production)
BTC_ENVIRONMENT=development
PORT=8000

# Security & CORS (comma-separated origins allowed to access backend)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.netlify.app,https://*.pages.dev

# Cloud Persistence ($0/mo Free Tier Turso LibSQL Database - Optional)
# Leave blank to use local SQLite WAL (experiments/results/market_memory.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gmail SMTP Email Notification Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=manuashi2018@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password_here
SMTP_FROM=manuashi2018@gmail.com
EMAIL_RECIPIENT=manuashi2018@gmail.com

# Optional Discord / Telegram Webhook Credentials
WEBHOOK_ENABLED=false
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

